# Copy to .env (gitignored) and fill in. Loaded into the shell from ~/.zshrc;
# pi and Pinet read these straight from the environment.

# GLM (Z.ai coding plan) and MiniMax
ZAI_API_KEY=
MINIMAX_API_KEY=

# Slack app for Pinet: OAuth & Permissions -> Bot token; Basic Information -> App-Level Token (connections:write)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Only this Slack user may drive pi (profile -> ... -> Copy member ID)
SLACK_MEMBER_ID=U
